<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digitalsignature_webhooksubscription_form.webhooksubscription_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Webhook Subscription</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="MageOS\DigitalSignature\Block\Adminhtml\WebhookSubscription\Edit\BackButton"/>
            <button name="delete" class="MageOS\DigitalSignature\Block\Adminhtml\WebhookSubscription\Edit\DeleteButton"/>
            <button name="save" class="MageOS\DigitalSignature\Block\Adminhtml\WebhookSubscription\Edit\SaveButton"/>
        </buttons>
        <namespace>digitalsignature_webhooksubscription_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>digitalsignature_webhooksubscription_form.webhooksubscription_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="webhooksubscription_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="digitalsignature/webhooksubscription/save"/>
        </settings>
        <dataProvider class="MageOS\DigitalSignature\Model\WebhookSubscription\DataProvider" name="webhooksubscription_form_data_source">
            <settings>
                <requestFieldName>subscription_id</requestFieldName>
                <primaryFieldName>subscription_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Webhook Subscription</label>
        </settings>
        <field name="subscription_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="target_url" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Target URL</label>
                <tooltip>
                    <description translate="true">HTTP/HTTPS endpoint to which JSON webhook push notifications are sent.</description>
                </tooltip>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-url" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="secret" formElement="password" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">HMAC Secret</label>
                <tooltip>
                    <description translate="true">Secret key used to sign the X-Signature header, populated as sha256= followed by the hex-encoded HMAC-SHA256. When editing, leave empty to keep the current secret.</description>
                </tooltip>
            </settings>
        </field>
        <field name="store_id" formElement="select" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Store View</label>
                <tooltip>
                    <description translate="true">Select the Store View for which to receive webhooks (leave empty for all stores).</description>
                </tooltip>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Store"/>
                        <caption translate="true">-- All Store Views --</caption>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="enabled" formElement="checkbox" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
