<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digitalsignature_apiconsumer_form.apiconsumer_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">API Integration</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="MageOS\DigitalSignature\Block\Adminhtml\ApiConsumer\Edit\BackButton"/>
            <button name="delete" class="MageOS\DigitalSignature\Block\Adminhtml\ApiConsumer\Edit\DeleteButton"/>
            <button name="save" class="MageOS\DigitalSignature\Block\Adminhtml\ApiConsumer\Edit\SaveButton"/>
        </buttons>
        <namespace>digitalsignature_apiconsumer_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>digitalsignature_apiconsumer_form.apiconsumer_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="apiconsumer_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="digitalsignature/apiconsumer/save"/>
        </settings>
        <dataProvider class="MageOS\DigitalSignature\Model\ApiConsumer\DataProvider" name="apiconsumer_form_data_source">
            <settings>
                <requestFieldName>consumer_id</requestFieldName>
                <primaryFieldName>consumer_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Integration</label>
        </settings>
        <field name="consumer_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="integration_id" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Integration ID</label>
                <tooltip>
                    <description translate="true">Numeric ID of the integration already created in System &gt; Integrations.</description>
                </tooltip>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="enabled" formElement="checkbox" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="store_ids" formElement="multiselect" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Store view</label>
                <tooltip>
                    <description translate="true">Store view this integration is authorized to operate on via API.</description>
                </tooltip>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Store"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>
</form>
