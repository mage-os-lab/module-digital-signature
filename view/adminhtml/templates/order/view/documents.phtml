<?php
/**
 * Tab "Documenti firma" nella vista ordine admin.
 *
 * @var \MageOS\DigitalSignature\Block\Adminhtml\Order\View\Documents $block
 */
declare(strict_types=1);

use MageOS\DigitalSignature\Api\Data\DocumentInterface;

$order = $block->getOrder();
if (!$order || !$order->getId()) {
    return;
}
$documents = $block->getDocuments();
?>
<section class="admin__page-section digitalsignature-order-documents">
    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Documenti firma')) ?></span>
        <div class="actions">
            <form method="post" action="<?= $block->escapeUrl($block->getGenerateUrl()) ?>"
                  style="display:inline-block;">
                <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
                <button type="submit" class="action-secondary" title="<?= $block->escapeHtmlAttr(__('Genera i documenti dei template con trigger manuale')) ?>">
                    <span><?= $block->escapeHtml(__('Genera documenti firma (manuale)')) ?></span>
                </button>
            </form>
        </div>
    </div>

    <?php if (empty($documents)): ?>
        <div class="admin__field-note">
            <span><?= $block->escapeHtml(__('Nessun documento firma per questo ordine.')) ?></span>
        </div>
    <?php else: ?>
        <table class="data-grid">
            <thead>
                <tr>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('ID')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Riga')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Template')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Provider')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Stato')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Trigger')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('ID processo')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Creato')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Azioni')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($documents as $doc): ?>
                    <?php /** @var DocumentInterface $doc */ ?>
                    <?php $active = $block->isActive($doc); ?>
                    <tr<?= $active ? '' : ' style="opacity:.6"' ?>>
                        <td class="data-grid-td">
                            #<?= (int)$doc->getDocumentId() ?>
                            <?php if (!$active): ?>
                                <small>(<?= $block->escapeHtml(__('storico')) ?>)</small>
                            <?php endif; ?>
                        </td>
                        <td class="data-grid-td"><?= $block->escapeHtml($block->getOrderItemLabel($doc->getOrderItemId())) ?></td>
                        <td class="data-grid-td"><?= $block->escapeHtml($block->getTemplateName($doc->getTemplateId())) ?></td>
                        <td class="data-grid-td"><?= $block->escapeHtml($doc->getProviderCode()) ?></td>
                        <td class="data-grid-td"><?= $block->escapeHtml($block->getStatusLabel($doc->getStatus())) ?></td>
                        <td class="data-grid-td"><?= $block->escapeHtml($doc->getTriggerCode()) ?></td>
                        <td class="data-grid-td"><?= $block->escapeHtml((string)$doc->getProviderProcessId() ?: '—') ?></td>
                        <td class="data-grid-td"><?= $block->escapeHtml($block->getFormattedDate($doc->getData('created_at'))) ?></td>
                        <td class="data-grid-td">
                            <?php if ($active): ?>
                                <form method="post" action="<?= $block->escapeUrl($block->getRegenerateUrl()) ?>"
                                      onsubmit="return confirm('<?= $block->escapeJs(__('Rigenerare e reinviare questo documento?')) ?>');">
                                    <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
                                    <input type="hidden" name="id" value="<?= (int)$doc->getDocumentId() ?>"/>
                                    <input type="hidden" name="order_id" value="<?= (int)$order->getId() ?>"/>
                                    <button type="submit" class="action-default scalable">
                                        <span><?= $block->escapeHtml(__('Rigenera / Reinvia')) ?></span>
                                    </button>
                                </form>
                            <?php else: ?>
                                <span>—</span>
                            <?php endif; ?>
                            <?php if ($doc->getErrorMessage()): ?>
                                <div class="digitalsignature-doc-error" style="color:#e22; margin-top:4px;">
                                    <small><?= $block->escapeHtml($doc->getErrorMessage()) ?></small>
                                </div>
                            <?php endif; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</section>
