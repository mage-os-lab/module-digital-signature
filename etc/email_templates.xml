<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Email:etc/email_templates.xsd">
    <template id="digital_signature_notifications_customer_ready_template"
              label="Digital Signature - Document ready (customer)"
              file="customer_ready.html"
              type="html"
              module="MageOS_DigitalSignature"
              area="frontend"/>
    <template id="digital_signature_notifications_customer_signed_template"
              label="Digital Signature - Document signed (customer)"
              file="customer_signed.html"
              type="html"
              module="MageOS_DigitalSignature"
              area="frontend"/>
    <template id="digital_signature_notifications_customer_outcome_template"
              label="Digital Signature - Document expired/declined (customer)"
              file="customer_outcome.html"
              type="html"
              module="MageOS_DigitalSignature"
              area="frontend"/>
    <template id="digital_signature_notifications_admin_error_template"
              label="Digital Signature - Document error (admin)"
              file="admin_error.html"
              type="html"
              module="MageOS_DigitalSignature"
              area="frontend"/>
    <template id="digital_signature_notifications_admin_outcome_template"
              label="Digital Signature - Document expired/declined (admin)"
              file="admin_outcome.html"
              type="html"
              module="MageOS_DigitalSignature"
              area="frontend"/>
    <template id="digital_signature_reminders_customer_template"
              label="Digital Signature - Document pending reminder (customer)"
              file="customer_reminder.html"
              type="html"
              module="MageOS_DigitalSignature"
              area="frontend"/>
    <template id="digital_signature_reminders_admin_template"
              label="Digital Signature - Document pending escalation (admin)"
              file="admin_escalation.html"
              type="html"
              module="MageOS_DigitalSignature"
              area="frontend"/>
</config>
