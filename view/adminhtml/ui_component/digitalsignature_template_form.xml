<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digitalsignature_template_form.template_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Template documento</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\BackButton"/>
            <button name="delete" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\DeleteButton"/>
            <button name="preview" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\PreviewButton"/>
            <button name="save" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\SaveButton"/>
        </buttons>
        <namespace>digitalsignature_template_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>digitalsignature_template_form.template_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="template_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="digitalsignature/template/save"/>
        </settings>
        <dataProvider class="MageOS\DigitalSignature\Model\Template\DataProvider" name="template_form_data_source">
            <settings>
                <requestFieldName>template_id</requestFieldName>
                <primaryFieldName>template_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Informazioni generali</label>
        </settings>
        <field name="template_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="store_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Nome template</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Attivo</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="is_required" formElement="checkbox" sortOrder="25">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Firma obbligatoria</label>
                <tooltip>
                    <description translate="true">Se attivo, il documento viene sempre generato al trigger, indipendentemente dalla scelta del cliente al checkout (l'indicazione al cliente è informativa e non deselezionabile).</description>
                </tooltip>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="scope" formElement="select" component="Magento_Ui/js/form/element/select" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">cart</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Ambito</label>
                <tooltip>
                    <description translate="true">Carrello/Ordine: un documento per l'intero ordine. Prodotto: un documento per ogni riga d'ordine dei prodotti assegnati.</description>
                </tooltip>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>cart</value>
                            <actions>
                                <action name="0">
                                    <target>digitalsignature_template_form.digitalsignature_template_form.assigned_products</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>product</value>
                            <actions>
                                <action name="0">
                                    <target>digitalsignature_template_form.digitalsignature_template_form.assigned_products</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">true</param>
                                    </params>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\DigitalSignature\Model\Template\Source\Scope"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="trigger_code" formElement="select" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Trigger di generazione</label>
                <tooltip>
                    <description translate="true">Quando generare e inviare il documento al provider di firma. Vuoto = usa il default globale di configurazione. Può essere ulteriormente sovrascritto a livello di singolo prodotto.</description>
                </tooltip>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\DigitalSignature\Model\Template\Source\TriggerWithDefault"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="pdf">
        <settings>
            <label translate="true">File PDF</label>
        </settings>
        <field name="pdf_use_default" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Usa file di default</label>
                <tooltip>
                    <description translate="true">Se attivo, questa store view usa il PDF della configurazione di default.</description>
                </tooltip>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="pdf_file" formElement="fileUploader" sortOrder="20">
            <settings>
                <label translate="true">PDF del contratto</label>
                <componentType>fileUploader</componentType>
                <notice translate="true">PDF contenente i tag placeholder firma, es. {WSIGN#80,20#email-placeholder}. L'email nel tag verrà sostituita con quella reale del cliente alla generazione. Se esporti da Adobe Acrobat, disabilita la compressione a oggetti (Object Level Compression) nelle impostazioni di esportazione — LibreOffice/Word/Google Docs vanno bene senza modifiche.</notice>
            </settings>
            <formElements>
                <fileUploader>
                    <settings>
                        <allowedExtensions>pdf</allowedExtensions>
                        <maxFileSize>10485760</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="digitalsignature/template/upload"/>
                        </uploaderConfig>
                    </settings>
                </fileUploader>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="assigned_products">
        <settings>
            <label translate="true">Prodotti assegnati</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <htmlContent name="assign_products_html">
            <block name="digitalsignature.template.assign.products"
                   class="MageOS\DigitalSignature\Block\Adminhtml\Template\AssignProducts"/>
        </htmlContent>
    </fieldset>
</form>
