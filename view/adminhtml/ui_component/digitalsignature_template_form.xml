<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digitalsignature_template_form.template_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Document Template</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\BackButton"/>
            <button name="delete" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\DeleteButton"/>
            <button name="preview" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\PreviewButton"/>
            <button name="save" class="MageOS\DigitalSignature\Block\Adminhtml\Template\Edit\SaveButton"/>
        </buttons>
        <namespace>digitalsignature_template_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>digitalsignature_template_form.template_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="template_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="digitalsignature/template/save"/>
        </settings>
        <dataProvider class="MageOS\DigitalSignature\Model\Template\DataProvider" name="template_form_data_source">
            <settings>
                <requestFieldName>template_id</requestFieldName>
                <primaryFieldName>template_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General Information</label>
        </settings>
        <field name="template_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="store_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Template Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="is_required" formElement="checkbox" sortOrder="25">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Signature Required</label>
                <tooltip>
                    <description translate="true">If active, the document is always generated on trigger, regardless of the customer's choice at checkout (the indication to the customer is informational and cannot be deselected).</description>
                </tooltip>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="scope" formElement="select" component="Magento_Ui/js/form/element/select" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">cart</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Scope</label>
                <tooltip>
                    <description translate="true">Cart/Order: one document for the entire order. Product: one document for each order line of the assigned products.</description>
                </tooltip>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>cart</value>
                            <actions>
                                <action name="0">
                                    <target>digitalsignature_template_form.digitalsignature_template_form.assigned_products</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">false</param>
                                    </params>
                                </action>
                            </actions>
                        </rule>
                        <rule name="1">
                            <value>product</value>
                            <actions>
                                <action name="0">
                                    <target>digitalsignature_template_form.digitalsignature_template_form.assigned_products</target>
                                    <callback>visible</callback>
                                    <params>
                                        <param name="0" xsi:type="boolean">true</param>
                                    </params>
                                </action>
                            </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\DigitalSignature\Model\Template\Source\Scope"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="trigger_code" formElement="select" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Generation Trigger</label>
                <tooltip>
                    <description translate="true">When to generate and send the document to the signature provider. Empty = use the global configuration default. Can be further overridden at the individual product level.</description>
                </tooltip>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\DigitalSignature\Model\Template\Source\TriggerWithDefault"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="pdf">
        <settings>
            <label translate="true">PDF File</label>
        </settings>
        <field name="pdf_use_default" formElement="checkbox" sortOrder="10">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Use default file</label>
                <tooltip>
                    <description translate="true">If active, this store view uses the PDF from the default configuration.</description>
                </tooltip>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="pdf_file" formElement="fileUploader" sortOrder="20">
            <settings>
                <label translate="true">Contract PDF</label>
                <componentType>fileUploader</componentType>
                <notice translate="true">PDF containing the signature placeholder tags, e.g. {WSIGN#80,20#email-placeholder}. The email in the tag will be replaced with the customer's real one at generation time. If exporting from Adobe Acrobat, disable object-level compression in the export settings — LibreOffice/Word/Google Docs work fine without changes.</notice>
            </settings>
            <formElements>
                <fileUploader>
                    <settings>
                        <allowedExtensions>pdf</allowedExtensions>
                        <maxFileSize>10485760</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="digitalsignature/template/upload"/>
                        </uploaderConfig>
                    </settings>
                </fileUploader>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="assigned_products">
        <settings>
            <label translate="true">Assigned Products</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <htmlContent name="assign_products_html">
            <block name="digitalsignature.template.assign.products"
                   class="MageOS\DigitalSignature\Block\Adminhtml\Template\AssignProducts"/>
        </htmlContent>
    </fieldset>
</form>
