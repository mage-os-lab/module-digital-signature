<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Csp\Model\Collector\DynamicCollector">
        <arguments>
            <argument name="policyCollectors" xsi:type="array">
                <item name="digitalsignature_pdfjs" xsi:type="object">MageOS\DigitalSignature\Model\Csp\PdfJsPolicyCollector</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="mageos_digitalsignature_audit_trail_compliance" xsi:type="object">MageOS\DigitalSignature\Model\Notification\AuditTrailComplianceMessage</item>
            </argument>
        </arguments>
    </type>
</config>
