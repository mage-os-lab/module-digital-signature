<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">digitalsignature_document_listing.digitalsignature_document_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>digitalsignature_document_columns</spinner>
        <deps>
            <dep>digitalsignature_document_listing.digitalsignature_document_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="digitalsignature_document_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">document_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MageOS_DigitalSignature::document</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="digitalsignature_document_listing_data_source">
            <settings>
                <requestFieldName>document_id</requestFieldName>
                <primaryFieldName>document_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="digitalsignature_document_columns">
        <column name="document_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="order_id" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID ordine</label>
            </settings>
        </column>
        <column name="provider_code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Provider</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <filter>select</filter>
                <options class="MageOS\DigitalSignature\Model\Document\Status"/>
                <dataType>select</dataType>
                <label translate="true">Stato</label>
            </settings>
        </column>
        <column name="trigger_code" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <filter>select</filter>
                <options class="MageOS\DigitalSignature\Model\Template\Source\Trigger"/>
                <dataType>select</dataType>
                <label translate="true">Trigger</label>
            </settings>
        </column>
        <column name="signer_email" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Email firmatario</label>
            </settings>
        </column>
        <column name="provider_process_id" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">ID processo</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <filter>select</filter>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <label translate="true">Attivo</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Creato il</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="MageOS\DigitalSignature\Ui\Component\Listing\Column\DocumentActions"
                       sortOrder="100">
            <settings>
                <indexField>document_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>160</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
