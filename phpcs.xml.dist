<?xml version="1.0"?>
<ruleset name="MageOS_DigitalSignature">
    <description>Magento2 coding standard, errors only: the same policy as the module's own CI.</description>
    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/Test/*</exclude-pattern>
    <exclude-pattern>*/TestSupport/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <arg value="n"/>
    <rule ref="Magento2"/>
</ruleset>
