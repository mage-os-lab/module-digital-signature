<?xml version="1.0"?>
<!--
    Copies the opt-in flag from the quote to the order during the
    quote -> order conversion (Magento\Quote\Model\Quote\Address\ToOrder). This way
    TriggerHandler reads $order->getData('digitalsignature_requested') without
    needing dedicated observers/plugins.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        <fieldset id="sales_convert_quote">
            <field name="digitalsignature_requested">
                <aspect name="to_order"/>
            </field>
        </fieldset>
    </scope>
</config>
