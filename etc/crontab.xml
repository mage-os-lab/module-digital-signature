<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="digitalsignature_reconcile" instance="MageOS\DigitalSignature\Cron\Reconcile" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="digitalsignature_webhook_retry" instance="MageOS\DigitalSignature\Cron\WebhookRetry" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="digitalsignature_retention_cleanup" instance="MageOS\DigitalSignature\Cron\RetentionCleanup" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="digitalsignature_reminder" instance="MageOS\DigitalSignature\Cron\SignatureReminder" method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
    </group>
</config>
