<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="mageos" translate="label" sortOrder="400">
            <label>Mage-OS</label>
        </tab>
        <section id="digital_signature" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Digital Signature</label>
            <tab>mageos</tab>
            <resource>MageOS_DigitalSignature::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="production_ack" translate="label comment" type="select" sortOrder="15"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>GDPR acknowledgement (production mode)</label>
                    <comment><![CDATA[Check this ONLY after signing a DPA (Data Processing Agreement) with the selected signature provider and updating the store's privacy policy to disclose that customer personal data (email, phone) is sent to a third-party provider for the signing process. Until this is checked, all new documents are generated with the dummy (test) provider, regardless of the provider configured below.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="default_trigger" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Default generation trigger</label>
                    <comment>Used when the template does not specify its own trigger.</comment>
                    <source_model>MageOS\DigitalSignature\Model\Template\Source\Trigger</source_model>
                </field>
                <field id="provider" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Active signature provider</label>
                    <comment>The connector used for new documents once production mode is confirmed above. Configure the credentials in the provider's group.</comment>
                    <source_model>MageOS\DigitalSignature\Model\Config\Source\Provider</source_model>
                </field>
                <field id="max_retries" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Maximum retries</label>
                    <comment>Maximum number of retries for temporary errors (network/service) before reaching the error state.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="reconcile_batch_limit" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Documents per reconciliation limit</label>
                    <comment>Cap on documents queued at each cron run (throttling towards the provider).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="pdfjs_source" translate="label" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>pdf.js library source</label>
                    <source_model>MageOS\DigitalSignature\Model\Config\Source\PdfJsSource</source_model>
                </field>
                <field id="pdfjs_cdn_url" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>pdf.js CDN URL</label>
                    <comment>E.g. https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/</comment>
                    <depends><field id="pdfjs_source">cdn</field></depends>
                </field>
                <field id="builder_tag_color" translate="label comment" type="select" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Signature tag color (PDF Builder)</label>
                    <comment>Color used to print the signature tag on the actual document generated for the order. Select "White (Invisible)" to hide it beneath the digital signature.</comment>
                    <source_model>MageOS\DigitalSignature\Model\Config\Source\TagColor</source_model>
                </field>
            </group>
            <group id="notifications" translate="label comment" type="text" sortOrder="15"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Email notifications</label>
                <comment>Emails sent to the customer and admin about signature document events.</comment>
                <field id="identity" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                </field>
                <field id="admin_recipient" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Admin recipient email</label>
                    <comment>For error and negative outcome notifications. Empty = store's general contact.</comment>
                    <validate>validate-email</validate>
                </field>
                <field id="customer_ready_enabled" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Notify the customer when the document is ready</label>
                    <comment>The provider often already sends its own signing invitation: disabled by default.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="customer_ready_template" translate="label" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>"Document ready" template (customer)</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="customer_ready_enabled">1</field></depends>
                </field>
                <field id="customer_signed_enabled" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Notify the customer when the document is signed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="customer_signed_template" translate="label" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>"Document signed" template (customer)</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="customer_signed_enabled">1</field></depends>
                </field>
                <field id="customer_outcome_enabled" translate="label comment" type="select" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Notify the customer if the document expires or is rejected</label>
                    <comment>Disabled by default to avoid alarming customers: evaluate on a case-by-case basis.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="customer_outcome_template" translate="label" type="select" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>"Expired/rejected" template (customer)</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="customer_outcome_enabled">1</field></depends>
                </field>
                <field id="admin_error_enabled" translate="label" type="select" sortOrder="90"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Notify the admin on a definitive error</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="admin_error_template" translate="label" type="select" sortOrder="100"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>"Document error" template (admin)</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="admin_error_enabled">1</field></depends>
                </field>
                <field id="admin_outcome_enabled" translate="label" type="select" sortOrder="110"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Notify the admin if the document expires or is rejected</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="admin_outcome_template" translate="label" type="select" sortOrder="120"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>"Expired/rejected" template (admin)</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="admin_outcome_enabled">1</field></depends>
                </field>
            </group>
            <group id="reminders" translate="label comment" type="text" sortOrder="18"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Automatic reminders</label>
                <comment>Reminders for documents awaiting signature.</comment>
                <field id="customer_enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Send reminders to the customer</label>
                    <comment>Sends periodic emails to the customer to remind them to sign. Disabled by default.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="customer_template" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Reminder template (customer)</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="customer_enabled">1</field></depends>
                </field>
                <field id="customer_threshold_days" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Days before the first reminder</label>
                    <comment>Days elapsed since sending before the first customer reminder.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="customer_enabled">1</field></depends>
                </field>
                <field id="customer_interval_days" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Days between subsequent reminders</label>
                    <comment>Days to wait between one reminder and the next.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="customer_enabled">1</field></depends>
                </field>
                <field id="customer_max_reminders" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Maximum number of customer reminders</label>
                    <comment>Maximum number of times to remind the customer.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="customer_enabled">1</field></depends>
                </field>
                <field id="admin_enabled" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Send escalation to the admin</label>
                    <comment>Sends a notification to the admin if the document remains unsigned. Enabled by default.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="admin_template" translate="label" type="select" sortOrder="70"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Escalation template (admin)</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="admin_enabled">1</field></depends>
                </field>
                <field id="admin_threshold_days" translate="label comment" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Days before admin escalation</label>
                    <comment>Days elapsed since sending before alerting the admin.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="admin_enabled">1</field></depends>
                </field>
                <field id="batch_limit" translate="label comment" type="text" sortOrder="90"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Documents per run limit</label>
                    <comment>Cap on documents processed at each cron run.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="webhooks" translate="label comment" type="text" sortOrder="19"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Webhook</label>
                <comment>Outbound notifications to external systems about document events.</comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable webhooks</label>
                    <comment>Sends the configured webhooks to active subscriptions. Disabled by default.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="max_attempts" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Maximum number of attempts</label>
                    <comment>Delivery attempts before marking the webhook as permanently failed.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="batch_limit" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Deliveries per run limit</label>
                    <comment>Cap on deliveries processed at each reconciliation cron run.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="failure_notification_enabled" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Notify admin on permanent failure</label>
                    <comment>Sends an email to the admin when a webhook delivery exhausts its attempts. Enabled by default.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="failure_notification_template" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Webhook failure notification template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="failure_notification_enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="providers" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Signature providers</label>
                <group id="wssign" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>WsSign</label>
                    <field id="info" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                        <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\System\Config\ProviderInfo\WsSign</frontend_model>
                    </field>
                    <field id="enabled" translate="label" type="select" sortOrder="10"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="platform_url" translate="label comment" type="text" sortOrder="20"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Platform URL</label>
                        <comment>E.g. https://demo.wsign.cloud (HTTPS only).</comment>
                        <validate>required-entry validate-url</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="tenant" translate="label" type="text" sortOrder="30"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Tenant</label>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="username" translate="label comment" type="text" sortOrder="40"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Username (owner)</label>
                        <comment>Email of the WsSign owner account.</comment>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="password" translate="label" type="obscure" sortOrder="50"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Password</label>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="signature_type" translate="label comment" type="text" sortOrder="60"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Signature type</label>
                        <comment>Default OTP_SMS: requires the signer's phone number.</comment>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="expiration_days" translate="label" type="text" sortOrder="70"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Signature expiration (days)</label>
                        <validate>validate-digits validate-greater-than-zero</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="default_phone_prefix" translate="label" type="text" sortOrder="80"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Default phone prefix</label>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="notes" translate="label comment" type="textarea" sortOrder="90"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Message for the signer</label>
                        <comment>Sent by the provider in the signing invitation.</comment>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="notifier_email" translate="label comment" type="text" sortOrder="100"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Notifier email (optional)</label>
                        <comment>Address notified by WsSign about process events.</comment>
                        <validate>validate-email</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="allowed_ips" translate="label comment" type="text" sortOrder="110"
                           showInDefault="1" showInWebsite="0" showInStore="0">
                        <label>Callback IP allowlist</label>
                        <comment>Comma-separated IPs; empty = no IP filtering (the secret token still applies).</comment>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="status_mapping" translate="label comment" sortOrder="120"
                           showInDefault="1" showInWebsite="0" showInStore="0">
                        <label>Status mapping</label>
                        <comment>Raw status returned by WsSign → internal document status. Unmapped statuses are logged so they can be added here.</comment>
                        <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\Form\Field\StatusMapping</frontend_model>
                        <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="quota_enabled" translate="label comment" type="select" sortOrder="200"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enable Quota Tracking</label>
                        <comment>Track signature credit consumption and send warning notifications when approaching limits.</comment>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="quota_type" translate="label comment" type="select" sortOrder="210"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Quota Model</label>
                        <source_model>MageOS\DigitalSignature\Model\Config\Source\QuotaType</source_model>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                    <field id="total_quota" translate="label comment" type="text" sortOrder="220"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Total Quota / Included Signatures</label>
                        <comment>Total signatures included in prepaid package or monthly/annual allowance (e.g. 500).</comment>
                        <validate>validate-digits</validate>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                    <field id="alert_threshold_percent" translate="label comment" type="text" sortOrder="230"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Alert Threshold (%)</label>
                        <comment>Send warning notification when remaining quota drops below this percentage (e.g. 15).</comment>
                        <validate>validate-digits</validate>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                </group>
                <group id="docusign" translate="label comment" type="text" sortOrder="12"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>DocuSign</label>
                    <comment>Integration with the DocuSign platform.</comment>
                    <field id="info" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                        <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\System\Config\ProviderInfo\Docusign</frontend_model>
                    </field>
                    <field id="enabled" translate="label" type="select" sortOrder="10"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="environment" translate="label comment" type="select" sortOrder="20"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Environment</label>
                        <source_model>MageOS\DigitalSignature\Model\Config\Source\Environment</source_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="integration_key" translate="label comment" type="text" sortOrder="30"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Integration Key (Client ID)</label>
                        <comment>Integration key retrieved from the DocuSign Console.</comment>
                        <validate>required-entry</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="secret_key" translate="label comment" type="obscure" sortOrder="40"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Secret Key (Client Secret)</label>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="account_id" translate="label comment" type="text" sortOrder="50"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>API Account ID</label>
                        <comment>Account ID visible in the Apps and Keys section.</comment>
                        <validate>required-entry</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="user_id" translate="label comment" type="text" sortOrder="60"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>API User ID (GUID)</label>
                        <comment>Required for Service Account JWT authentication.</comment>
                        <validate>required-entry</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="private_key" translate="label comment" type="textarea" sortOrder="70"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>RSA Private Key</label>
                        <comment>Copy and paste the complete RSA private key generated on DocuSign (including the BEGIN/END PRIVATE KEY tags).</comment>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="expiration_days" translate="label" type="text" sortOrder="80"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Envelope expiration (days)</label>
                        <validate>validate-digits validate-greater-than-zero</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="notes" translate="label comment" type="textarea" sortOrder="90"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Email message for the signer</label>
                        <comment>Sent in the body of the DocuSign notification email.</comment>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="status_mapping" translate="label comment" sortOrder="120"
                           showInDefault="1" showInWebsite="0" showInStore="0">
                        <label>Status mapping</label>
                        <comment>Raw status returned by DocuSign → internal document status. Unmapped statuses are logged so they can be added here.</comment>
                        <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\Form\Field\StatusMapping</frontend_model>
                        <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="quota_enabled" translate="label comment" type="select" sortOrder="200"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enable Quota Tracking</label>
                        <comment>Track signature credit consumption and send warning notifications when approaching limits.</comment>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="quota_type" translate="label comment" type="select" sortOrder="210"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Quota Model</label>
                        <source_model>MageOS\DigitalSignature\Model\Config\Source\QuotaType</source_model>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                    <field id="total_quota" translate="label comment" type="text" sortOrder="220"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Total Quota / Included Signatures</label>
                        <comment>Total signatures included in prepaid package or monthly/annual allowance (e.g. 500).</comment>
                        <validate>validate-digits</validate>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                    <field id="alert_threshold_percent" translate="label comment" type="text" sortOrder="230"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Alert Threshold (%)</label>
                        <comment>Send warning notification when remaining quota drops below this percentage (e.g. 15).</comment>
                        <validate>validate-digits</validate>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                </group>
                <group id="adobesign" translate="label comment" type="text" sortOrder="14"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Adobe Acrobat Sign</label>
                    <comment>Integration with the Adobe Acrobat Sign platform.</comment>
                    <field id="info" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                        <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\System\Config\ProviderInfo\AdobeSign</frontend_model>
                    </field>
                    <field id="enabled" translate="label" type="select" sortOrder="10"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="client_id" translate="label comment" type="text" sortOrder="30"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Application ID (Client ID)</label>
                        <comment>Application ID retrieved from the Adobe Developer Console.</comment>
                        <validate>required-entry</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="client_secret" translate="label comment" type="obscure" sortOrder="40"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Client Secret</label>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="refresh_token" translate="label comment" type="obscure" sortOrder="50"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>OAuth Refresh Token</label>
                        <comment>Long-lived refresh token used to generate API Access Tokens.</comment>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="api_access_point" translate="label comment" type="text" sortOrder="55"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>API Access Point</label>
                        <comment>
                            E.g. https://api.na1.adobesign.com. Unlike DocuSign, Adobe Sign has no fixed
                            demo/production host: the shard is tied to the account and must be copied from the
                            "api_access_point" returned during the initial OAuth exchange (interactive authorization).
                        </comment>
                        <validate>required-entry</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="expiration_days" translate="label" type="text" sortOrder="60"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Agreement expiration (days)</label>
                        <validate>validate-digits validate-greater-than-zero</validate>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="notes" translate="label comment" type="textarea" sortOrder="70"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Message for the signer</label>
                        <comment>Sent in the Adobe Acrobat Sign notification email.</comment>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="status_mapping" translate="label comment" sortOrder="120"
                           showInDefault="1" showInWebsite="0" showInStore="0">
                        <label>Status mapping</label>
                        <comment>Raw status returned by Adobe Acrobat Sign → internal document status. Unmapped statuses are logged so they can be added here.</comment>
                        <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\Form\Field\StatusMapping</frontend_model>
                        <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="quota_enabled" translate="label comment" type="select" sortOrder="200"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enable Quota Tracking</label>
                        <comment>Track signature credit consumption and send warning notifications when approaching limits.</comment>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <depends><field id="enabled">1</field></depends>
                    </field>
                    <field id="quota_type" translate="label comment" type="select" sortOrder="210"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Quota Model</label>
                        <source_model>MageOS\DigitalSignature\Model\Config\Source\QuotaType</source_model>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                    <field id="total_quota" translate="label comment" type="text" sortOrder="220"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Total Quota / Included Signatures</label>
                        <comment>Total signatures included in prepaid package or monthly/annual allowance (e.g. 500).</comment>
                        <validate>validate-digits</validate>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                    <field id="alert_threshold_percent" translate="label comment" type="text" sortOrder="230"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Alert Threshold (%)</label>
                        <comment>Send warning notification when remaining quota drops below this percentage (e.g. 15).</comment>
                        <validate>validate-digits</validate>
                        <depends><field id="quota_enabled">1</field></depends>
                    </field>
                </group>
                <group id="dummy" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Dummy (test only)</label>
                    <comment>Fake provider that simulates signing locally. Do NOT use in production.</comment>
                    <field id="info" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                        <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\System\Config\ProviderInfo\Dummy</frontend_model>
                    </field>
                    <field id="allow" translate="label comment" type="select" sortOrder="10"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Allow dummy provider</label>
                        <comment>WARNING: enable only in test/development environments.</comment>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="auto_sign_delay" translate="label comment" type="text" sortOrder="20"
                           showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Auto-sign delay (seconds)</label>
                        <comment>After this time the document is marked as signed.</comment>
                        <validate>validate-digits</validate>
                        <depends><field id="allow">1</field></depends>
                    </field>
                </group>
                <field id="available_connectors" translate="label comment" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional connectors</label>
                    <frontend_model>MageOS\DigitalSignature\Block\Adminhtml\System\Config\AvailableConnectors</frontend_model>
                </field>
            </group>
            <group id="retention" translate="label comment" type="text" sortOrder="25"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Document retention (GDPR)</label>
                <comment><![CDATA[Daily cron that, when active, deletes PDFs and personal data (email/phone) of completed documents (signed/rejected/expired/cancelled) past the retention period. The record and status history are kept for audit/tax purposes, without the PDF or PII.]]></comment>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Automatically delete past the retention period</label>
                    <comment>Disabled by default: deletion is destructive and should be enabled deliberately after defining the required retention periods (tax/legal).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="retention_days" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Retention days</label>
                    <comment>From the last status change of the completed document. Default 3650 (10 years, indicative: check the applicable tax/legal terms).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="batch_limit" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Documents per run limit</label>
                    <comment>Cap on documents processed at each cron run.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
