<?xml version="1.0"?>
<!--
    Invalidates the digitalsignature-signature section when the cart changes
    (so the minicart reflects whether the opt-in is still applicable) and after
    saving the customer's choice.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Customer/etc/sections.xsd">
    <action name="checkout/cart/add">
        <section name="digitalsignature-signature"/>
    </action>
    <action name="checkout/cart/delete">
        <section name="digitalsignature-signature"/>
    </action>
    <action name="checkout/cart/updatePost">
        <section name="digitalsignature-signature"/>
    </action>
    <action name="checkout/cart/updateItemOptions">
        <section name="digitalsignature-signature"/>
    </action>
    <action name="digitalsignature/cart/setRequested">
        <section name="digitalsignature-signature"/>
    </action>
</config>
