<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <massaction name="listing_massaction">
        <action name="digitalsignature_generate_documents">
            <settings>
                <confirm>
                    <message translate="true">Generare i documenti firma per gli ordini selezionati?</message>
                    <title translate="true">Genera documenti firma</title>
                </confirm>
                <url path="digitalsignature/order/massGenerateDocuments"/>
                <type>digitalsignature_generate_documents</type>
                <label translate="true">Genera documenti firma</label>
            </settings>
        </action>
    </massaction>
</listing>
