<?php
/** @var \MageOS\DigitalSignature\Block\Adminhtml\System\Config\ProviderInfo\AbstractProviderInfo $block */
$links = $block->getLinks();
$isRecommended = $block->isRecommended();
$recommendationText = $block->getRecommendationText();
$demoWarning = $block->getDemoWarning();
?>
<div class="digitalsignature-provider-info" style="display:flex;align-items:flex-start;gap:16px;padding:12px;max-width:760px;<?php if ($isRecommended): ?>border:1px solid #79a22e;border-radius:6px;background-color:#f6faf0;<?php endif; ?>">
    <span style="display:flex;align-items:center;justify-content:center;width:64px;height:64px;flex:0 0 auto;overflow:hidden;border-radius:4px;">
        <img src="<?= $block->escapeUrl($block->getLogoUrl()) ?>"
             alt="<?= $block->escapeHtmlAttr($block->getProviderName()) ?>"
             style="max-width:100%;max-height:100%;object-fit:contain;" />
    </span>
    <div>
        <strong style="font-size:1.1em;"><?= $block->escapeHtml($block->getProviderName()) ?></strong>
        <div style="margin:4px 0;">
            <span style="font-size:0.9em;font-weight:bold;color:#4f5b66;background-color:#e0e6ed;padding:2px 6px;border-radius:4px;display:inline-block;">
                <?= $block->escapeHtml($block->getLegalLevel()) ?>
            </span>
            <?php if ($isRecommended): ?>
                <span style="font-size:0.9em;font-weight:bold;color:#fff;background-color:#79a22e;padding:2px 6px;border-radius:4px;display:inline-block;">
                    <?= $block->escapeHtml(__('Consigliato')) ?>
                </span>
            <?php endif; ?>
        </div>
        <?php if ($isRecommended && $recommendationText): ?>
            <p style="margin:6px 0;font-weight:bold;color:#3d5115;"><?= $block->escapeHtml($recommendationText) ?></p>
        <?php endif; ?>
        <?php if ($demoWarning): ?>
            <p style="margin:6px 0;font-size:0.9em;font-weight:bold;color:#8a6d3b;background-color:#fcf2df;border:1px solid #f0d9a8;border-radius:4px;padding:6px 10px;">
                &#9888; <?= $block->escapeHtml($demoWarning) ?>
            </p>
        <?php endif; ?>
        <p style="margin:6px 0;"><?= $block->escapeHtml($block->getDescription()) ?></p>
        <?php if ($links): ?>
            <ul style="margin:0;padding-left:18px;">
                <?php foreach ($links as $link): ?>
                    <li>
                        <?php if (!empty($link['url'])): ?>
                            <a href="<?= $block->escapeUrl($link['url']) ?>" target="_blank" rel="noopener noreferrer">
                                <?= $block->escapeHtml($link['label']) ?>
                            </a>
                        <?php else: ?>
                            <?= $block->escapeHtml($link['label']) ?>
                        <?php endif; ?>
                        <?php if (!empty($link['note'])): ?>
                            <em>(<?= $block->escapeHtml($link['note']) ?>)</em>
                        <?php endif; ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
        <p style="margin:10px 0 0 0;font-size:0.85em;color:#777;border-top:1px solid #ddd;padding-top:6px;line-height:1.4;">
            <?= $block->escapeHtml(__('Note: The classification of the signature level is based on the specifications declared by the provider. The module does not guarantee legal adequacy or compliance for specific purposes.')) ?>
        </p>
    </div>
</div>
