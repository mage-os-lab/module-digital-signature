<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="digitalsignature-signature" xsi:type="string">MageOS\DigitalSignature\Model\CustomerData\SignatureSection</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="digitalsignature_checkout_signature"
                type="MageOS\DigitalSignature\Plugin\Checkout\LayoutProcessorPlugin"/>
    </type>
</config>
