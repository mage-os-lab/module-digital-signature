<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <block class="Magento\Framework\View\Element\Template"
                   name="digitalsignature.cart.signature"
                   before="checkout.cart.methods"
                   template="MageOS_DigitalSignature::checkout/cart/signature.phtml">
                <arguments>
                    <argument name="signature_view_model" xsi:type="object">MageOS\DigitalSignature\Model\ViewModel\SignatureRequest</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
